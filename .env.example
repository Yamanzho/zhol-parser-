# Шаблон локальной конфигурации. «Установить Zhol.command» копирует его в .env
# и сам заполняет пустые пароли. Этот файл не содержит паролей и разрешений.
# Не вписывайте сюда ключи, токены и значения ZHOL_*_BROWSER_GRANT.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
API_PORT=18080
WEB_PORT=15173

DATABASE_URL=
FILES_DIR=/data/files
BROWSER_PROFILES_DIR=/data/profiles
PUBLIC_BASE_URL=
FILE_LINK_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
TELEGRAM_BOT_TOKEN=
RESPONSIBLE_TG_CHAT_ID=

SYNTONY_MODE=stub
SYNTONY_BASE_URL=
SYNTONY_API_KEY=
SYNTONY_WEBHOOK_SECRET=
ZHOL_API_KEY=

# Ключ Catalog API 2ГИС с platform.2gis.ru. Пустое значение оставляет этот сбор выключенным.
DGIS_CATALOG_KEY=

# Письменное разрешение на сбор в браузере. Пустое значение оставляет источник закрытым.
# Допустимы только два текста, и они не взаимозаменяемы:
# written-browser-retention-local
# written-browser-retention-commercial
# Разрешение одной площадки не открывает другую. Текст разрешения в репозиторий не кладут.
ZHOL_2GIS_BROWSER_GRANT=
ZHOL_YANDEX_BROWSER_GRANT=
ZHOL_GOOGLE_BROWSER_GRANT=

# Пустое значение выключает /api/v1/admin. Установщик записывает длинную случайную строку.
ZHOL_ADMIN_TOKEN=
# Установщик и «Запустить Zhol.command» заполняют локальный вход. Это не bearer-токен.
ZHOL_LOCAL_GATE=

INVOICE_PROVIDER=stub
SECRETS_KEY=
TZ=Asia/Almaty
ZHOL_BROWSER_ENGINE=1
